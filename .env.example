# Base URL for the Django API.
#
# Leave as /api in development: vite.config.ts proxies /api to Django, so the
# browser makes same-origin requests and CORS is not involved at all.
#
# Set an absolute URL (e.g. https://api.example.com/api) to call Django
# directly. That origin must then appear in CORS_ALLOWED_ORIGINS in the
# backend's config/settings.py.
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api. Only read by vite.config.ts at startup,
# never shipped to the browser.
VITE_PROXY_TARGET=http://127.0.0.1:8000
