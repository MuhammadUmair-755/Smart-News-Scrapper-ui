# Rendered to /etc/nginx/conf.d/default.conf at container start.
# Only ${API_PROXY_TARGET} is substituted (NGINX_ENVSUBST_FILTER); nginx's own
# $-variables have no braces and pass through untouched.

server {
    listen       8080;
    server_name  _;
    root         /usr/share/nginx/html;
    index        index.html;

    # Publisher URLs are long and article titles are not short.
    large_client_header_buffers 4 16k;

    gzip              on;
    gzip_vary         on;
    gzip_min_length   256;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/javascript
                      application/json image/svg+xml;
    # Note: woff2 is already compressed. Gzipping it again wastes CPU and can
    # make it marginally larger, so it is deliberately absent above.

    # --- API -----------------------------------------------------------------
    # No trailing slash on proxy_pass, so the full /api/... path is forwarded
    # unchanged — Django serves these routes at /api/ too.
    location /api/ {
        proxy_pass         ${API_PROXY_TARGET};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # DRF issues a 301 from /api/articles to /api/articles/. Rewriting it
        # keeps the redirect on this origin instead of leaking the upstream one.
        proxy_redirect     ~^(https?://[^/]+)(/.*)$ $2;

        proxy_connect_timeout 5s;
        proxy_read_timeout    30s;
    }

    # --- Hashed build assets -------------------------------------------------
    # Vite fingerprints these filenames, so the content at a given URL never
    # changes. Cache hard.
    location /assets/ {
        access_log off;
        # One header, not two: `expires 1y` would emit its own Cache-Control
        # alongside this one. max-age is the year.
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files  $uri =404;
    }

    # --- SPA fallback --------------------------------------------------------
    # index.html must NEVER be cached: it carries the hashed asset references,
    # so a stale copy pins the whole app to a build that no longer exists.
    location / {
        try_files  $uri $uri/ /index.html;
        add_header Cache-Control "no-cache, must-revalidate";
    }

    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # Don't advertise the exact nginx version.
    server_tokens off;
}
